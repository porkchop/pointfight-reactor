[tool_use] Write {"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/artifacts/phase4-reverify/verify.mjs","content":"import { chromium } from 'playwright';\nimport { mkdirSync } from 'node:fs';\nimport { resolve } from 'node:path';\n\nconst OUT = resolve('/home/aaron/dev/projects/aaron/pointfight-reactor/artifacts/phase4-reverify');\nmkdirSync(OUT, { recursive: true });\n\nconst consoleErrors = [];\nconst allConsole = [];\n\nfunction attachConsole(page, label) {\n  page.on('console', (msg) => {\n    const text = `[${label}] ${msg.type()}: ${msg.text()}`;\n    allConsole.push(text);\n    if (msg.type() === 'error') consoleErrors.push(text);\n  });\n  page.on('pageerror', (err) => {\n    const text = `[${label}] pageerror: ${err.message}`;\n    allConsole.push(text);\n    consoleErrors.push(text);\n  });\n}\n\nasync function clearIDB(page) {\n  await page.evaluate(async () => {\n    await new Promise((res, rej) => {\n      const req = indexedDB.deleteDatabase('pointfight-reactor');\n      req.onsuccess = () => res();\n      req.onerror = () => rej(req.error);\n      req.onblocked = () => res();\n    });\n  });\n}\n\nasync function main() {\n  const browser = await chromium.launch();\n  const ctx = await browser.newContext();\n  const page = await ctx.newPage();\n  attachConsole(page, 'main');\n\n  const results = {};\n\n  // ====================== Defect 1 ======================\n  // First load to register the SW/IDB\n  await page.goto('http://localhost:5177/', { waitUntil: 'networkidle' });\n  await page.waitForTimeout(500);\n\n  // Clear IDB\n  await clearIDB(page);\n  // Hard reload\n  await page.reload({ waitUntil: 'networkidle' });\n  await page.waitForTimeout(800);\n\n  await page.screenshot({ path: `${OUT}/01-idle-after-clear.png`, fullPage: true });\n\n  // Open Settings\n  const settingsBtn = page.getByRole('button', { name: /settings/i }).first();\n  await settingsBtn.click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: `${OUT}/02-settings-open.png`, fullPage: true });\n\n  // Find select for Active profile and count \"Default\" entries\n  const selects = await page.locator('select').all();\n  let defaultCount = -1;\n  let allOptions = [];\n  for (const sel of selects) {\n    const opts = await sel.locator('option').allTextContents();\n    allOptions.push(opts);\n    const c = opts.filter((t) => t.trim() === 'Default').length;\n    if (c > 0) defaultCount = c;\n  }\n  results.defect1 = {\n    defaultCount,\n    allOptions,\n    pass: defaultCount === 1,\n  };\n\n  // ====================== Defect 2 ======================\n  // Already on Settings. Create new profile \"Sparring\".\n  // Look for a button/input to create profile.\n  const newNameInput = page.locator('input[type=\"text\"]').first();\n  await newNameInput.fill('Sparring');\n  await page.screenshot({ path: `${OUT}/03-sparring-typed.png`, fullPage: true });\n\n  const createBtn = page.getByRole('button', { name: /create|new profile|add/i }).first();\n  await createBtn.click();\n  await page.waitForTimeout(500);\n  await page.screenshot({ path: `${OUT}/04-after-create.png`, fullPage: true });\n\n  // Close settings - find a \"Close\" or \"Back\" or \"Done\" button. Try a few.\n  const closeCandidates = [/done/i, /close/i, /back/i, /save/i];\n  let closed = false;\n  for (const re of closeCandidates) {\n    const btn = page.getByRole('button', { name: re });\n    if ((await btn.count()) > 0) {\n      await btn.first().click();\n      closed = true;\n      break;\n    }\n  }\n  await page.waitForTimeout(500);\n  await page.screenshot({ path: `${OUT}/05-after-close-settings.png`, fullPage: true });\n\n  // Check idle shows \"Profile: Sparring\"\n  const idleTextAfterCreate = await page.locator('body').innerText();\n  const showsSparring = /Profile:\\s*Sparring/i.test(idleTextAfterCreate);\n  results.defect2_step2_showsSparring = showsSparring;\n\n  // Open settings again\n  await page.getByRole('button', { name: /settings/i }).first().click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: `${OUT}/06-settings-reopened.png`, fullPage: true });\n\n  // Switch dropdown to Default\n  const profileSelect = page.locator('select').first();\n  await profileSelect.selectOption({ label: 'Default' });\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: `${OUT}/07-selected-default.png`, fullPage: true });\n\n  // Click Save\n  const saveBtn = page.getByRole('button', { name: /save/i }).first();\n  await saveBtn.click();\n  await page.waitForTimeout(600);\n  await page.screenshot({ path: `${OUT}/08-after-save.png`, fullPage: true });\n\n  // Now on idle screen, check it shows Profile: Default\n  const idleAfterSwitch = await page.locator('body').innerText();\n  const showsDefault = /Profile:\\s*Default/i.test(idleAfterSwitch);\n  const stillSparring = /Profile:\\s*Sparring/i.test(idleAfterSwitch);\n  results.defect2 = {\n    showsDefault,\n    stillSparring,\n    idleSample: idleAfterSwitch.slice(0, 600),\n    pass: showsDefault && !stillSparring,\n  };\n\n  // ====================== Bonus regression ======================\n  // Settings opens without errors - already done. New profile creation works (Sparring exists).\n  // Run a tiny drill to check Summary \"Rhythm pattern\" renders.\n  // Find the Start button (might be on idle).\n  await page.screenshot({ path: `${OUT}/09-before-drill.png`, fullPage: true });\n  const startBtn = page.getByRole('button', { name: /^start/i }).first();\n  if ((await startBtn.count()) > 0) {\n    await startBtn.click();\n    await page.waitForTimeout(300);\n    // Try to do a minimal interaction - press space or click target a few times\n    // Just wait through it (drill has rounds). Let's try a short countdown.\n    // Press keys to react\n    for (let i = 0; i < 30; i++) {\n      await page.keyboard.press('Space');\n      await page.waitForTimeout(150);\n    }\n    await page.waitForTimeout(3000);\n    await page.screenshot({ path: `${OUT}/10-after-drill.png`, fullPage: true });\n    const finalText = await page.locator('body').innerText();\n    results.bonus_rhythmPanel = /rhythm pattern/i.test(finalText);\n    results.bonus_finalSample = finalText.slice(0, 800);\n  } else {\n    results.bonus_rhythmPanel = 'no-start-button-found';\n  }\n\n  results.consoleErrors = consoleErrors;\n  results.consoleErrorCount = consoleErrors.length;\n  results.allConsoleTail = allConsole.slice(-50);\n\n  await browser.close();\n\n  const fs = await import('node:fs');\n  fs.writeFileSync(`${OUT}/results.json`, JSON.stringify(results, null, 2));\n  console.log(JSON.stringify(results, null, 2));\n}\n\nmain().catch((e) => {\n  console.error('FATAL', e);\n  process.exit(1);\n});\n"}
