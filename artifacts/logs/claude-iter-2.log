2	import type { RepRecord, SessionRecord } from '../engine/types'
3	import type { SettingsRecord } from './settings-types'
4	import type { ProfileRecord } from './profiles'
5	
6	export class ReactorDB extends Dexie {
7	  sessions!: EntityTable<SessionRecord, 'id'>
8	  reps!: EntityTable<RepRecord, 'id'>
9	  settings!: EntityTable<SettingsRecord, 'id'>
10	  profiles!: EntityTable<ProfileRecord, 'id'>
11	
12	  constructor() {
13	    super('pointfight-reactor')
14	    this.version(1).stores({
15	      sessions: 'id, startedAt',
16	      reps: 'id, sessionId, cueId',
17	    })
18	    this.version(2).stores({
19	      sessions: 'id, startedAt',
20	      reps: 'id, sessionId, cueId',
21	      settings: 'id',
22	    })
23	    this.version(3).stores({
24	      sessions: 'id, startedAt',
25	      reps: 'id, sessionId, cueId',
26	      settings: 'id',
27	      profiles: 'id, createdAt',
28	    })
29	  }
30	}
31	
32	let _db: ReactorDB | null = nul
