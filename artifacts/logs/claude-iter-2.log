[tool_use] Write {"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/cues/palette.tsx","content":"import type { CueId } from '../engine/types'\n\ninterface PictographProps {\n  className?: string\n}\n\nexport interface PaletteEntry {\n  id: CueId\n  Pictograph: (props: PictographProps) => React.ReactElement\n  accentClass: string\n  animationClass: string\n}\n\nconst VIEWBOX = '0 0 120 160'\nconst BODY_STROKE = 'var(--gym-fg)'\nconst ACCENT = 'var(--gym-accent)'\nconst DANGER = 'var(--gym-bad)'\nconst WARN = 'var(--gym-warn)'\n\nfunction BaseFigure({\n  bodyTransform,\n  legTransform,\n  armTransform,\n  className,\n  children,\n}: {\n  bodyTransform?: string\n  legTransform?: string\n  armTransform?: string\n  className?: string\n  children?: React.ReactNode\n}) {\n  return (\n    <svg\n      className={className}\n      viewBox={VIEWBOX}\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      <g\n        stroke={BODY_STROKE}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      >\n        <g transform={bodyTransform}>\n          {/* head */}\n          <circle cx=\"60\" cy=\"22\" r=\"14\" />\n          {/* torso */}\n          <line x1=\"60\" y1=\"36\" x2=\"60\" y2=\"86\" />\n          {/* arms */}\n          <g transform={armTransform}>\n            <line x1=\"60\" y1=\"50\" x2=\"36\" y2=\"74\" />\n            <line x1=\"60\" y1=\"50\" x2=\"84\" y2=\"74\" />\n          </g>\n          {/* legs */}\n          <g transform={legTransform}>\n            <line x1=\"60\" y1=\"86\" x2=\"42\" y2=\"132\" />\n            <line x1=\"60\" y1=\"86\" x2=\"78\" y2=\"132\" />\n          </g>\n        </g>\n      </g>\n      {children}\n    </svg>\n  )\n}\n\nfunction StepsInPictograph({ className }: PictographProps) {\n  return (\n    <BaseFigure\n      className={`${className ?? ''} cue-steps-in`}\n      bodyTransform=\"translate(0 0)\"\n    >\n      {/* forward arrow at base */}\n      <path\n        d=\"M 86 132 L 110 132 M 102 124 L 110 132 L 102 140\"\n        stroke={ACCENT}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      />\n    </BaseFigure>\n  )\n}\n\nfunction BlitzesPictograph({ className }: PictographProps) {\n  return (\n    <BaseFigure className={`${className ?? ''} cue-blitzes`}>\n      {/* speed lines behind */}\n      <g stroke={DANGER} strokeWidth=\"5\" strokeLinecap=\"round\">\n        <line x1=\"14\" y1=\"58\" x2=\"40\" y2=\"58\" />\n        <line x1=\"10\" y1=\"80\" x2=\"38\" y2=\"80\" />\n        <line x1=\"14\" y1=\"102\" x2=\"40\" y2=\"102\" />\n      </g>\n    </BaseFigure>\n  )\n}\n\nfunction LiftsLegPictograph({ className }: PictographProps) {\n  return (\n    <svg\n      className={`${className ?? ''} cue-lifts-leg`}\n      viewBox={VIEWBOX}\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      <g\n        stroke={BODY_STROKE}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      >\n        <circle cx=\"60\" cy=\"22\" r=\"14\" />\n        <line x1=\"60\" y1=\"36\" x2=\"60\" y2=\"86\" />\n        <line x1=\"60\" y1=\"50\" x2=\"36\" y2=\"74\" />\n        <line x1=\"60\" y1=\"50\" x2=\"84\" y2=\"74\" />\n        {/* stationary back leg */}\n        <line x1=\"60\" y1=\"86\" x2=\"78\" y2=\"132\" />\n      </g>\n      {/* lifted lead leg (animates) */}\n      <g\n        className=\"cue-leg-lift\"\n        stroke={WARN}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      >\n        <line x1=\"60\" y1=\"86\" x2=\"42\" y2=\"110\" />\n        <line x1=\"42\" y1=\"110\" x2=\"32\" y2=\"92\" />\n      </g>\n    </svg>\n  )\n}\n\nfunction DropsHandPictograph({ className }: PictographProps) {\n  return (\n    <svg\n      className={`${className ?? ''} cue-drops-hand`}\n      viewBox={VIEWBOX}\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      <g\n        stroke={BODY_STROKE}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      >\n        <circle cx=\"60\" cy=\"22\" r=\"14\" />\n        <line x1=\"60\" y1=\"36\" x2=\"60\" y2=\"86\" />\n        {/* fixed rear arm */}\n        <line x1=\"60\" y1=\"50\" x2=\"84\" y2=\"74\" />\n        {/* legs */}\n        <line x1=\"60\" y1=\"86\" x2=\"42\" y2=\"132\" />\n        <line x1=\"60\" y1=\"86\" x2=\"78\" y2=\"132\" />\n      </g>\n      {/* dropping lead arm (animates from up to down) */}\n      <g\n        className=\"cue-arm-drop\"\n        stroke={ACCENT}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      >\n        <line x1=\"60\" y1=\"50\" x2=\"36\" y2=\"78\" />\n      </g>\n    </svg>\n  )\n}\n\nfunction RetreatsPictograph({ className }: PictographProps) {\n  return (\n    <BaseFigure className={`${className ?? ''} cue-retreats`}>\n      {/* backward arrow */}\n      <path\n        d=\"M 34 132 L 10 132 M 18 124 L 10 132 L 18 140\"\n        stroke={ACCENT}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      />\n    </BaseFigure>\n  )\n}\n\nfunction FreezesPictograph({ className }: PictographProps) {\n  return (\n    <BaseFigure className={`${className ?? ''} cue-freezes`}>\n      {/* pause/halt bars on either side */}\n      <g fill={WARN}>\n        <rect x=\"6\" y=\"60\" width=\"10\" height=\"40\" rx=\"2\" />\n        <rect x=\"104\" y=\"60\" width=\"10\" height=\"40\" rx=\"2\" />\n      </g>\n    </BaseFigure>\n  )\n}\n\nfunction FakeStepsPictograph({ className }: PictographProps) {\n  return (\n    <BaseFigure className={`${className ?? ''} cue-fake-steps`}>\n      {/* twitchy double-headed arrow */}\n      <path\n        d=\"M 24 132 L 96 132 M 32 124 L 24 132 L 32 140 M 88 124 L 96 132 L 88 140\"\n        stroke={DANGER}\n        strokeWidth=\"5\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      />\n    </BaseFigure>\n  )\n}\n\nfunction NoGoBaitPictograph({ className }: PictographProps) {\n  return (\n    <svg\n      className={`${className ?? ''} cue-no-go-bait`}\n      viewBox={VIEWBOX}\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      <g\n        stroke={BODY_STROKE}\n        strokeWidth=\"6\"\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      >\n        <circle cx=\"60\" cy=\"22\" r=\"14\" />\n        <line x1=\"60\" y1=\"36\" x2=\"60\" y2=\"86\" />\n        <line x1=\"60\" y1=\"50\" x2=\"36\" y2=\"74\" />\n        <line x1=\"60\" y1=\"50\" x2=\"84\" y2=\"74\" />\n        <line x1=\"60\" y1=\"86\" x2=\"42\" y2=\"132\" />\n        <line x1=\"60\" y1=\"86\" x2=\"78\" y2=\"132\" />\n      </g>\n      {/* big NO circle-slash */}\n      <g stroke={DANGER} strokeWidth=\"7\" fill=\"none\">\n        <circle cx=\"60\" cy=\"78\" r=\"56\" />\n        <line x1=\"22\" y1=\"40\" x2=\"98\" y2=\"116\" />\n      </g>\n    </svg>\n  )\n}\n\nexport const CUE_PALETTE: Record<CueId, PaletteEntry> = {\n  steps_in: {\n    id: 'steps_in',\n    Pictograph: StepsInPictograph,\n    accentClass: 'accent-accent',\n    animationClass: 'anim-step-in',\n  },\n  blitzes: {\n    id: 'blitzes',\n    Pictograph: BlitzesPictograph,\n    accentClass: 'accent-danger',\n    animationClass: 'anim-blitz',\n  },\n  lifts_lead_leg: {\n    id: 'lifts_lead_leg',\n    Pictograph: LiftsLegPictograph,\n    accentClass: 'accent-warn',\n    animationClass: 'anim-leg-lift',\n  },\n  drops_lead_hand: {\n    id: 'drops_lead_hand',\n    Pictograph: DropsHandPictograph,\n    accentClass: 'accent-accent',\n    animationClass: 'anim-hand-drop',\n  },\n  retreats: {\n    id: 'retreats',\n    Pictograph: RetreatsPictograph,\n    accentClass: 'accent-accent',\n    animationClass: 'anim-retreat',\n  },\n  freezes: {\n    id: 'freezes',\n    Pictograph: FreezesPictograph,\n    accentClass: 'accent-warn',\n    animationClass: 'anim-freeze',\n  },\n  fake_steps: {\n    id: 'fake_steps',\n    Pictograph: FakeStepsPictograph,\n    accentClass: 'accent-danger',\n    animationClass: 'anim-fake-step',\n  },\n  no_go_bait: {\n    id: 'no_go_bait',\n    Pictograph: NoGoBaitPictograph,\n    accentClass: 'accent-danger',\n    animationClass: 'anim-bait',\n  },\n}\n"}
