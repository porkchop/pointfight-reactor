[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/App.tsx","old_string":"  if (phase === 'idle')\n    return (\n      <IdleScreen\n        onOpenSettings={() => setView('settings')}\n        onOpenAnalytics={() => setView('analytics')}\n        onOpenPair={() => {\n          setPairOpener('idle')\n          setView('pair')\n        }}\n        onOpenClips={() => setView('clips')}\n      />\n    )\n  if (phase === 'ended') return <SummaryScreen />\n  return (\n    <TrainerScreen\n      commitKeyCode={settings.commitKeyCode}\n      commitKeyLabel={settings.commitKeyLabel}\n    />\n  )\n}","new_string":"  // Clip-mode routing — checked before the live-session routing so that a\n  // running clip drill is not pre-empted by useSession.phase=='idle'.\n  if (clipPhase !== 'idle' && clipPhase !== 'ended') {\n    return (\n      <Suspense fallback={<div className=\"screen\">Loading clip drill…</div>}>\n        <ClipDrillScreen\n          commitKeyCode={settings.commitKeyCode}\n          commitKeyLabel={settings.commitKeyLabel}\n        />\n      </Suspense>\n    )\n  }\n  if (clipPhase === 'ended') {\n    return (\n      <SummaryScreen\n        mode=\"clip\"\n        onClose={() => {\n          resetClip()\n          setView('idle')\n        }}\n      />\n    )\n  }\n\n  if (phase === 'idle')\n    return (\n      <IdleScreen\n        onOpenSettings={() => setView('settings')}\n        onOpenAnalytics={() => setView('analytics')}\n        onOpenPair={() => {\n          setPairOpener('idle')\n          setView('pair')\n        }}\n        onOpenClips={() => setView('clips')}\n      />\n    )\n  if (phase === 'ended') return <SummaryScreen />\n  return (\n    <TrainerScreen\n      commitKeyCode={settings.commitKeyCode}\n      commitKeyLabel={settings.commitKeyLabel}\n    />\n  )\n}"}
