[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/store/session.ts","old_string":"  // Phase 6.3 — rep-minting + persistence is now centralized in\n  // `engine/persistence.ts:commitRep`. This thin wrapper applies the\n  // session-store side effects (phase transition, feedback hand-off,\n  // session-progress save) on top.\n  function commitRep(\n    cue: CueDef,\n    distance: Distance | null,\n    cueShownAt: number,\n    pressedAt: number | null,\n    classification: ClassifyOutput,\n  ): void {\n    const state = get()\n    if (!state.sessionId || state.sessionStartedAt === null) return\n    void commitRepHelper({\n      cue,\n      distance,\n      cueShownAt,\n      pressedAt,\n      classification,\n      sessionId: state.sessionId,\n      roundIndex: state.roundIndex,\n      inputSource: state.inputSource,\n    }).then(({ rep, feedback }) => {\n      const cur = get()\n      set({\n        phase: 'feedback',\n        feedback,\n        reps: [...cur.reps, rep],\n      })\n      persistSession(null)\n    })\n  }","new_string":"  // Phase 6.3 — rep-minting + persistence is now centralized in\n  // `engine/persistence.ts:commitRep`. This wrapper applies the\n  // session-store side effects (phase transition, feedback hand-off,\n  // session-progress save) on top of the shared rep-build path so\n  // `clipmode/runner.ts` can call the same helper without duplicating\n  // the invariants encoded here.\n  function commitRep(\n    cue: CueDef,\n    distance: Distance | null,\n    cueShownAt: number,\n    pressedAt: number | null,\n    classification: ClassifyOutput,\n  ): void {\n    const state = get()\n    if (!state.sessionId || state.sessionStartedAt === null) return\n    const { rep, feedback } = commitRepHelper({\n      cue,\n      distance,\n      cueShownAt,\n      pressedAt,\n      classification,\n      sessionId: state.sessionId,\n      roundIndex: state.roundIndex,\n      inputSource: state.inputSource,\n    })\n    set({\n      phase: 'feedback',\n      feedback,\n      reps: [...state.reps, rep],\n    })\n    persistSession(null)\n  }"}
