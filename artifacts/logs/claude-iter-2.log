[tool_use] Write {"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/ui/PairScreen.tsx","content":"import { useEffect, useRef, useState } from 'react'\nimport { createPeer, type PeerHandle, type PeerState } from '../phone/peer'\nimport type { PhoneMessage } from '../phone/wire'\nimport { loadSettings } from '../store/settings'\n\ninterface PairScreenProps {\n  onClose: () => void\n}\n\n/**\n * Phase 2b.1 — laptop-side pairing UI. Manual SDP copy/paste.\n *\n * Intentional throwaway UX (decision memo §\"Throwaway scaffolding\"): the\n * two-textarea flow ships only to prove the WebRTC DataChannel transport.\n * Phase 2b.2 replaces this with QR scanning; the only parts that survive\n * past 2b.1 are `phone/peer.ts`, `phone/wire.ts`, and the `/phone` route.\n */\nexport function PairScreen({ onClose }: PairScreenProps) {\n  const peerRef = useRef<PeerHandle | null>(null)\n  const [state, setState] = useState<PeerState>('idle')\n  const [offerText, setOfferText] = useState('')\n  const [answerText, setAnswerText] = useState('')\n  const [phoneUrl, setPhoneUrl] = useState<string | null>(null)\n  const [err, setErr] = useState<string | null>(null)\n  const [lastCommit, setLastCommit] = useState<{\n    receivedAt: number\n    sentAt: number\n  } | null>(null)\n  const startedAtRef = useRef<number | null>(null)\n\n  useEffect(() => {\n    let cancelled = false\n    void loadSettings().then((s) => {\n      if (cancelled) return\n      const ip = s.laptopLanIp?.trim()\n      const port =\n        typeof window !== 'undefined' && window.location.port\n          ? window.location.port\n          : '5173'\n      if (ip) setPhoneUrl(`http://${ip}:${port}/phone`)\n    })\n    return () => {\n      cancelled = true\n      peerRef.current?.close()\n    }\n  }, [])\n\n  async function handleGenerateOffer(): Promise<void> {\n    setErr(null)\n    if (peerRef.current) {\n      setErr('Already generated an offer — reload to start over.')\n      return\n    }\n    try {\n      const peer = createPeer()\n      peerRef.current = peer\n      peer.onStateChange(setState)\n      peer.onMessage((m: PhoneMessage) => {\n        if (m.type === 'commit') {\n          setLastCommit({ receivedAt: Date.now(), sentAt: m.t })\n        }\n      })\n      startedAtRef.current = Date.now()\n      const offer = await peer.createOffer()\n      setOfferText(offer)\n    } catch (e) {\n      setErr(e instanceof Error ? e.message : String(e))\n    }\n  }\n\n  async function handleAcceptAnswer(): Promise<void> {\n    setErr(null)\n    const peer = peerRef.current\n    if (!peer) {\n      setErr('Generate an offer first.')\n      return\n    }\n    if (!answerText.trim()) {\n      setErr('Paste the answer SDP from the phone.')\n      return\n    }\n    try {\n      await peer.acceptAnswer(answerText)\n    } catch (e) {\n      setErr(e instanceof Error ? e.message : String(e))\n    }\n  }\n\n  const sinceStart =\n    startedAtRef.current !== null && lastCommit\n      ? lastCommit.receivedAt - startedAtRef.current\n      : null\n\n  return (\n    <div className=\"screen pair-screen\">\n      <header className=\"settings-header\">\n        <h1>Pair phone (Phase 2b.1)</h1>\n        <button type=\"button\" className=\"link\" onClick={onClose}>\n          Close\n        </button>\n      </header>\n\n      <p className=\"hint\">\n        Manual SDP pairing — temporary scaffolding. Phase 2b.2 replaces this\n        with QR scanning.\n      </p>\n\n      <section className=\"settings-section\">\n        <h2>1. Open the phone companion page</h2>\n        {phoneUrl ? (\n          <p>\n            On your phone, open <code data-testid=\"phone-url\">{phoneUrl}</code>.\n          </p>\n        ) : (\n          <p className=\"hint\">\n            Set your laptop's LAN IP in Settings to see the phone URL here.\n          </p>\n        )}\n      </section>\n\n      <section className=\"settings-section\">\n        <h2>2. Generate an offer</h2>\n        <button\n          type=\"button\"\n          className=\"primary\"\n          onClick={() => void handleGenerateOffer()}\n          disabled={state !== 'idle' && state !== 'error'}\n        >\n          Generate offer\n        </button>\n        <textarea\n          aria-label=\"offer SDP\"\n          rows={6}\n          value={offerText}\n          readOnly\n          placeholder=\"(generated by clicking Generate offer)\"\n        />\n        <p className=\"hint\">Copy this whole block onto the phone screen.</p>\n      </section>\n\n      <section className=\"settings-section\">\n        <h2>3. Paste the phone's answer</h2>\n        <textarea\n          aria-label=\"answer SDP\"\n          rows={6}\n          value={answerText}\n          onChange={(e) => setAnswerText(e.target.value)}\n          placeholder=\"v=0…\"\n        />\n        <button\n          type=\"button\"\n          className=\"primary\"\n          onClick={() => void handleAcceptAnswer()}\n          disabled={state !== 'awaiting_answer'}\n        >\n          Connect\n        </button>\n      </section>\n\n      <section className=\"settings-section\">\n        <h2>4. Status</h2>\n        <p>\n          Connection: <strong data-testid=\"pair-state\">{state}</strong>\n        </p>\n        {lastCommit && (\n          <p data-testid=\"last-commit\">\n            Last commit received at +{sinceStart}ms (phone clock t=\n            {lastCommit.sentAt}).\n          </p>\n        )}\n      </section>\n\n      {err && (\n        <div className=\"banner warn\" role=\"alert\">\n          {err}\n        </div>\n      )}\n    </div>\n  )\n}\n"}
