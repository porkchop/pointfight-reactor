[tool_use] Bash {"command":"cat >> src/App.css <<'EOF'\n\n/* ---- Phase 6.3 clip-mode UI ---- */\n.mode-segmented {\n  display: inline-flex;\n  gap: 0;\n  padding: 0;\n  margin: 0.8rem 0;\n  border: 1px solid var(--gym-line, #2a2a2a);\n  border-radius: 8px;\n  overflow: hidden;\n}\n.mode-segmented label {\n  padding: 0.4rem 0.9rem;\n  cursor: pointer;\n  font-size: 0.95rem;\n}\n.mode-segmented label:has(input:checked) {\n  background: var(--gym-neutral, #1e1e1e);\n  font-weight: 600;\n}\n.mode-segmented input[type='radio'] {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  clip: rect(0 0 0 0);\n  overflow: hidden;\n}\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  border: 0;\n}\n.clip-drill-stage {\n  position: relative;\n}\n.clip-drill-video {\n  width: 100%;\n  max-height: 70vh;\n  background: #000;\n  border-radius: 8px;\n}\n.cue-table.per-clip {\n  margin-top: 0.8rem;\n}\n.cue-table.per-clip caption {\n  text-align: left;\n  font-family: ui-monospace, monospace;\n  color: var(--gym-muted);\n  padding-bottom: 0.3rem;\n}\nEOF","description":"Add CSS for new clip-mode UI"}
