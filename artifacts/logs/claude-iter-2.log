[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/ui/SummaryScreen.tsx","old_string":"      <div className=\"actions\">\n        <button\n          type=\"button\"\n          className=\"primary\"\n          onClick={() => start(config, undefined, inputSource)}\n        >\n          Start another session\n        </button>\n        <button type=\"button\" className=\"link\" onClick={() => reset()}>\n          Back to start\n        </button>\n      </div>\n    </div>\n  )\n}","new_string":"      {isClip && perClipBreakdown.length > 0 && (\n        <>\n          <h2>By clip</h2>\n          {perClipBreakdown.map(({ clipId, clipName, rows }) => (\n            <table\n              key={clipId}\n              className=\"cue-table per-clip\"\n              data-testid=\"per-clip-breakdown\"\n              data-clip-id={clipId}\n            >\n              <caption>{clipName}</caption>\n              <thead>\n                <tr>\n                  <th>Cue</th>\n                  <th>Reps</th>\n                  <th>Correct</th>\n                  <th>FS</th>\n                  <th>Hes</th>\n                  <th>Late</th>\n                  <th>Avg RT</th>\n                </tr>\n              </thead>\n              <tbody>\n                {rows.map((row) => {\n                  const cue = CUE_LIBRARY.find((c) => c.id === row.cueId)\n                  return (\n                    <tr key={row.cueId}>\n                      <td>{cue?.label ?? row.cueId}</td>\n                      <td>{row.reps}</td>\n                      <td>{row.correct}</td>\n                      <td>{row.falseStarts}</td>\n                      <td>{row.hesitations}</td>\n                      <td>{row.lateMisses}</td>\n                      <td>\n                        {row.avgRtMs === null ? '—' : `${row.avgRtMs}`}\n                      </td>\n                    </tr>\n                  )\n                })}\n              </tbody>\n            </table>\n          ))}\n        </>\n      )}\n\n      <div className=\"actions\">\n        {!isClip && (\n          <button\n            type=\"button\"\n            className=\"primary\"\n            onClick={() => liveStart(config, undefined, inputSource)}\n          >\n            Start another session\n          </button>\n        )}\n        <button\n          type=\"button\"\n          className=\"link\"\n          onClick={() => (isClip ? onClose?.() : liveReset())}\n        >\n          Back to start\n        </button>\n      </div>\n    </div>\n  )\n}"}
