[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/App.css","old_string":".idle-links {\n  display: flex;\n  gap: 0.6rem;\n  justify-content: center;\n  flex-wrap: wrap;\n}","new_string":".idle-links {\n  display: flex;\n  gap: 0.6rem;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n\n/* ---- Clip library (Phase 6.1) ---- */\n.clip-library {\n  align-items: stretch;\n  justify-content: flex-start;\n  max-width: 760px;\n  margin: 0 auto;\n  width: 100%;\n}\n.clip-library-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  margin-bottom: 1.2rem;\n}\n.clip-library-header h1 {\n  margin: 0;\n}\n.clip-import {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin: 1rem 0 1.6rem;\n}\n.clip-import label.link {\n  cursor: pointer;\n}\n.clip-import label.link[aria-disabled='true'] {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n.clip-quota {\n  color: var(--gym-muted);\n  font-size: 0.95rem;\n  font-family: ui-monospace, monospace;\n}\n.clip-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  width: 100%;\n}\n.clip-list li {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: var(--gym-neutral);\n  padding: 0.7rem 1rem;\n  border-radius: 8px;\n}\n.clip-row-main {\n  display: flex;\n  flex-direction: column;\n  gap: 0.15rem;\n  min-width: 0;\n  flex: 1;\n}\n.clip-name {\n  font-weight: 600;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.clip-meta {\n  color: var(--gym-muted);\n  font-size: 0.9rem;\n  font-family: ui-monospace, monospace;\n}\n.clip-needs-tag {\n  color: var(--gym-warn);\n}"}
