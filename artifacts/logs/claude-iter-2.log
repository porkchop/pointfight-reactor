[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/App.css","old_string":".cue-label {\n  font-size: clamp(5rem, 16vw, 14rem);\n  font-weight: 900;\n  letter-spacing: -2px;\n  line-height: 0.95;\n  text-align: center;\n  color: var(--gym-fg);\n}\n.cue-sub {\n  font-size: clamp(1.3rem, 3vw, 2.2rem);\n  color: var(--gym-muted);\n  letter-spacing: 4px;\n  text-transform: uppercase;\n}","new_string":".cue-label {\n  font-size: clamp(3rem, 9vw, 7rem);\n  font-weight: 900;\n  letter-spacing: -2px;\n  line-height: 0.95;\n  text-align: center;\n  color: var(--gym-fg);\n}\n.cue-sub {\n  font-size: clamp(1.3rem, 3vw, 2.2rem);\n  color: var(--gym-muted);\n  letter-spacing: 4px;\n  text-transform: uppercase;\n}\n.cue-stage {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1rem;\n}\n.cue-pictograph-wrap {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transform-origin: center center;\n  transition: transform 120ms ease-out;\n}\n.cue-pictograph {\n  width: clamp(220px, 38vw, 520px);\n  height: auto;\n  filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.45));\n}\n.accent-accent .cue-pictograph { color: var(--gym-accent); }\n.accent-danger .cue-pictograph { color: var(--gym-bad); }\n.accent-warn   .cue-pictograph { color: var(--gym-warn); }\n\n.cue-overlay {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.4rem;\n}\n.cue-distance-label {\n  font-size: 1.2rem;\n  letter-spacing: 6px;\n  color: var(--gym-accent);\n  text-transform: uppercase;\n}\n\n/* ---- Per-cue keyframe animations ---- */\n.anim-step-in       { animation: stepIn 600ms ease-out both; }\n.anim-blitz         { animation: blitz 380ms ease-out both; }\n.anim-leg-lift .cue-leg-lift { animation: legLift 700ms ease-out both; transform-origin: 60px 86px; }\n.anim-hand-drop .cue-arm-drop { animation: armDrop 700ms ease-out both; transform-origin: 60px 50px; }\n.anim-retreat       { animation: retreat 600ms ease-out both; }\n.anim-freeze        { animation: freezeFlash 700ms ease-out both; }\n.anim-fake-step     { animation: fakeStep 700ms ease-in-out both; }\n.anim-bait          { animation: bait 800ms ease-in-out both; }\n\n@keyframes stepIn {\n  0%   { transform: translateX(-20px); opacity: 0.6; }\n  60%  { transform: translateX(8px);   opacity: 1; }\n  100% { transform: translateX(0);     opacity: 1; }\n}\n@keyframes blitz {\n  0%   { transform: translateX(-22px) scale(0.96); opacity: 0.5; }\n  100% { transform: translateX(0)     scale(1);    opacity: 1; }\n}\n@keyframes legLift {\n  0%   { transform: rotate(0); }\n  60%  { transform: rotate(-32deg); }\n  100% { transform: rotate(-28deg); }\n}\n@keyframes armDrop {\n  0%   { transform: rotate(-70deg); }\n  100% { transform: rotate(0); }\n}\n@keyframes retreat {\n  0%   { transform: translateX(0); opacity: 1; }\n  100% { transform: translateX(-18px); opacity: 0.9; }\n}\n@keyframes freezeFlash {\n  0%   { opacity: 0.4; }\n  20%  { opacity: 1; }\n  100% { opacity: 1; }\n}\n@keyframes fakeStep {\n  0%   { transform: translateX(0); }\n  30%  { transform: translateX(10px); }\n  60%  { transform: translateX(-2px); }\n  100% { transform: translateX(0); }\n}\n@keyframes bait {\n  0%   { opacity: 0.4; transform: scale(0.95); }\n  50%  { opacity: 1;   transform: scale(1.02); }\n  100% { opacity: 1;   transform: scale(1); }\n}"}
