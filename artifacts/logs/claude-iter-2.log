[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/App.tsx","old_string":"function App() {\n  const phase = useSession((s) => s.phase)\n  const [view, setView] = useState<IdleView>('idle')\n  const [settings, setSettings] = useState<SettingsRecord>(DEFAULT_SETTINGS)\n\n  useEffect(() => {\n    void loadSettings().then(setSettings)\n  }, [view])\n\n  if (view === 'settings') {\n    return (\n      <SettingsScreen\n        onClose={() => setView('idle')}\n        onOpenPair={() => setView('pair')}\n      />\n    )\n  }\n  if (view === 'analytics') {\n    return <AnalyticsScreen onClose={() => setView('idle')} />\n  }\n  if (view === 'pair') {\n    return (\n      <Suspense fallback={<div className=\"screen\">Loading pair UI…</div>}>\n        <PairScreen onClose={() => setView('settings')} />\n      </Suspense>\n    )\n  }\n  if (phase === 'idle')\n    return (\n      <IdleScreen\n        onOpenSettings={() => setView('settings')}\n        onOpenAnalytics={() => setView('analytics')}\n        onOpenPair={() => setView('pair')}\n      />\n    )","new_string":"function App() {\n  const phase = useSession((s) => s.phase)\n  const [view, setView] = useState<IdleView>('idle')\n  // Remember which view sent the user to pair so closing returns there.\n  const [pairOpener, setPairOpener] = useState<'idle' | 'settings'>('settings')\n  const [settings, setSettings] = useState<SettingsRecord>(DEFAULT_SETTINGS)\n\n  useEffect(() => {\n    void loadSettings().then(setSettings)\n  }, [view])\n\n  if (view === 'settings') {\n    return (\n      <SettingsScreen\n        onClose={() => setView('idle')}\n        onOpenPair={() => {\n          setPairOpener('settings')\n          setView('pair')\n        }}\n      />\n    )\n  }\n  if (view === 'analytics') {\n    return <AnalyticsScreen onClose={() => setView('idle')} />\n  }\n  if (view === 'pair') {\n    return (\n      <Suspense fallback={<div className=\"screen\">Loading pair UI…</div>}>\n        <PairScreen onClose={() => setView(pairOpener)} />\n      </Suspense>\n    )\n  }\n  if (phase === 'idle')\n    return (\n      <IdleScreen\n        onOpenSettings={() => setView('settings')}\n        onOpenAnalytics={() => setView('analytics')}\n        onOpenPair={() => {\n          setPairOpener('idle')\n          setView('pair')\n        }}\n      />\n    )"}
