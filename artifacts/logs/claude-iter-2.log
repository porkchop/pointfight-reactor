[tool_result] toolu_01QErLwh1XwuPkUGuCgadyKe 1	import { describe, expect, it } from 'vitest'
2	import { CUE_LIBRARY, GO_CUES, NO_GO_CUES } from './library'
3	
4	describe('cue library', () => {
5	  it('contains both go and no-go cues', () => {
6	    expect(GO_CUES.length).toBeGreaterThan(0)
7	    expect(NO_GO_CUES.length).toBeGreaterThan(0)
8	  })
9	
10	  it('has unique ids', () => {
11	    const ids = CUE_LIBRARY.map((c) => c.id)
12	    expect(new Set(ids).size).toBe(ids.length)
13	  })
14	
15	  it('no-go cues all map to do_nothing', () => {
16	    for (const cue of NO_GO_CUES) {
17	      expect(cue.expectedResponse).toBe('do_nothing')
18	    }
19	  })
20	})
21	
