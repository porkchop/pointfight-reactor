12	export function pickPreCueDelayMs(rng: RNG, config: DrillConfig): number {
13	  return randInt(rng, config.preCueMinMs, config.preCueMaxMs)
14	}
15	
16	export function pickNextCue(rng: RNG, config: DrillConfig): CueDef {
17	  const isGo = rng() < config.goCueProbability
18	  const pool = isGo ? GO_CUES : NO_GO_CUES
19	  if (pool.length === 0) {
20	    throw new Error('pickNextCue: empty pool')
21	  }
22	  return pool[Math.floor(rng() * pool.length)]
23	}
