[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/App.css","old_string":".banner.warn {\n  background: var(--gym-warn);\n  color: #1a1208;\n  padding: 0.8rem 1rem;\n  border-radius: 8px;\n  margin-bottom: 1.2rem;\n  font-weight: 600;\n}","new_string":".banner.warn {\n  background: var(--gym-warn);\n  color: #1a1208;\n  padding: 0.8rem 1rem;\n  border-radius: 8px;\n  margin-bottom: 1.2rem;\n  font-weight: 600;\n}\n.banner.info {\n  background: var(--gym-neutral);\n  color: var(--gym-fg);\n  border: 1px solid var(--gym-accent);\n  padding: 0.6rem 1rem;\n  border-radius: 8px;\n  font-size: 1rem;\n}\n.banner.warn ul {\n  margin: 0;\n  padding-left: 1.2rem;\n}\n\n/* ---- HUD ---- */\n.hud-clock,\n.hud-penalties {\n  font-family: ui-monospace, monospace;\n  color: var(--gym-fg);\n  font-size: 1.1rem;\n  padding: 0.2rem 0.55rem;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.05);\n}\n.hud-penalties {\n  color: var(--gym-warn);\n  font-weight: 700;\n}\n\n/* ---- Rest screen ---- */\n.screen.rest {\n  position: relative;\n  background: #0b1220;\n}\n.screen.rest .stage {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1.5rem;\n}\n.screen.rest h2 {\n  font-size: clamp(3rem, 8vw, 6rem);\n  letter-spacing: 8px;\n  margin: 0;\n  color: var(--gym-muted);\n}\n.rest-clock {\n  font-size: clamp(4rem, 14vw, 10rem);\n  font-family: ui-monospace, monospace;\n  font-weight: 800;\n  color: var(--gym-accent);\n  line-height: 1;\n}\n.penalty-panel {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.75rem;\n  background: var(--gym-neutral);\n  padding: 1.4rem 2rem;\n  border-radius: 12px;\n}\n.penalty-count {\n  font-size: 1.4rem;\n  font-weight: 700;\n  margin: 0;\n}\n.muted {\n  color: var(--gym-muted);\n  margin: 0;\n}\n\n/* ---- Settings screen ---- */\n.screen.settings {\n  align-items: stretch;\n  max-width: 720px;\n  margin: 0 auto;\n  width: 100%;\n  gap: 1.2rem;\n}\n.settings-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.settings-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n}\n.settings-section {\n  background: var(--gym-neutral);\n  padding: 1rem 1.2rem;\n  border-radius: 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 0.7rem;\n}\n.settings-section h2 {\n  margin: 0;\n  font-size: 1rem;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: var(--gym-muted);\n}\n.settings-section label {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n  font-size: 1rem;\n}\n.settings-section input[type='number'],\n.settings-section select {\n  background: #0b1220;\n  color: var(--gym-fg);\n  border: 1px solid #1f2937;\n  border-radius: 6px;\n  padding: 0.4rem 0.6rem;\n  font-size: 1rem;\n  min-width: 140px;\n}\n.settings-section .hint {\n  color: var(--gym-muted);\n  font-size: 0.9rem;\n  margin: 0;\n}\n.settings-section .checkbox-row {\n  justify-content: flex-start;\n  gap: 0.6rem;\n}\n.rebind-button {\n  background: #0b1220;\n  color: var(--gym-fg);\n  border: 1px solid var(--gym-accent);\n  border-radius: 6px;\n  padding: 0.4rem 0.8rem;\n  cursor: pointer;\n  font-family: ui-monospace, monospace;\n}\n.rebind-prompt {\n  color: var(--gym-accent);\n  font-style: italic;\n}\n.summary-meta {\n  color: var(--gym-muted);\n  margin: 0 0 1rem;\n}"}
