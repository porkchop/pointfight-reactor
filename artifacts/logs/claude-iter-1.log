19	  if (bytes < 1024) return `${bytes} B`
20	  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`
21	  return `${(bytes / 1024 / 1024).toFixed(1)} MB`
22	}
23	
24	function formatDuration(ms: number): string {
25	  if (!Number.isFinite(ms) || ms <= 0) return '—'
26	  const totalSec = Math.round(ms / 1000)
27	  const min = Math.floor(totalSec / 60)
28	  const sec = totalSec % 60
29	  return `${min}:${sec.toString().padStart(2, '0')}`
30	}
