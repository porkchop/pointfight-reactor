[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/App.css","old_string":".rhythm-panel p {\n  margin: 0;\n  font-size: 1.1rem;\n}","new_string":".rhythm-panel p {\n  margin: 0;\n  font-size: 1.1rem;\n}\n\n/* ---- Analytics screen ---- */\n.screen.analytics {\n  align-items: stretch;\n  max-width: 960px;\n  margin: 0 auto;\n  width: 100%;\n  gap: 1.2rem;\n}\n.analytics-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.analytics-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n}\n.analytics-section {\n  background: var(--gym-neutral);\n  padding: 1rem 1.2rem;\n  border-radius: 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 0.8rem;\n}\n.analytics-section h2 {\n  margin: 0;\n  font-size: 1rem;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: var(--gym-muted);\n}\n.trend-spark-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 0.4rem 1.2rem;\n}\n.spark-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.6rem;\n  font-size: 0.95rem;\n  color: var(--gym-fg);\n}\n.spark-label {\n  color: var(--gym-muted);\n}\n.spark {\n  color: var(--gym-accent);\n}\n.spark-empty {\n  color: var(--gym-muted);\n  font-size: 0.9rem;\n}\n.compare-pickers {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 0.6rem 1rem;\n}\n.compare-pickers label {\n  display: flex;\n  flex-direction: column;\n  gap: 0.3rem;\n  font-size: 0.95rem;\n  color: var(--gym-muted);\n}\n.compare-pickers select {\n  background: #0b1220;\n  color: var(--gym-fg);\n  border: 1px solid #1f2937;\n  border-radius: 6px;\n  padding: 0.4rem 0.6rem;\n  font-size: 1rem;\n}\n.compare-stats {\n  margin-top: 0.6rem;\n}\n.delta-good .stat-value { color: var(--gym-correct); }\n.delta-bad .stat-value  { color: var(--gym-bad); }\n.delta-neutral .stat-value { color: var(--gym-fg); }\ntr.compare-both_error_only td {\n  background: rgba(220, 38, 38, 0.12);\n}\ntr.compare-candidate_only td,\ntr.compare-baseline_only td {\n  color: var(--gym-muted);\n}\n.idle-links {\n  display: flex;\n  gap: 0.6rem;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n"}
