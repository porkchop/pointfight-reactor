0, w, h)\n      lastDecodeAt = now\n      const result = jsQR(image.data, w, h)\n      if (result && result.data) {\n        void handleDecodedAnswer(result.data)\n        return\n      }\n      scanRafRef.current = requestAnimationFrame(tick)\n    }\n    scanRafRef.current = requestAnimationFrame(tick)\n  }"}
