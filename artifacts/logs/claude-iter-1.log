[tool_result] toolu_01KrhXpxq1Gnpogu1GbApTVD 1	export type PhoneMessage =
2	  | { type: 'commit'; t: number }
3	  | { type: 'ping'; t: number }
4	
5	const KNOWN_TYPES = new Set<PhoneMessage['type']>(['commit', 'ping'])
6	
7	export function encodePhoneMessage(msg: PhoneMessage): string {
8	  return JSON.stringify(msg)
9	}
10	
11	export function decodePhoneMessage(raw: string): PhoneMessage | null {
12	  let parsed: unknown
13	  try {
14	    parsed = JSON.parse(raw)
15	  } catch {
16	    return null
17	  }
18	  return isPhoneMessage(parsed) ? parsed : null
19	}
20	
21	export function isPhoneMessage(v: unknown): v is PhoneMessage {
22	  if (typeof v !== 'object' || v === null) return false
23	  const o = v as Record<string, unknown>
24	  if (typeof o.type !== 'string') return false
25	  if (!KNOWN_TYPES.has(o.type as PhoneMessage['type'])) return false
26	  if (typeof o.t !== 'number') return false
27	  return true
28	}
29	
