3	/**
4	 * A locally imported video clip persisted in Dexie at schema version(4).
5	 * The `blob` field stores the raw .mp4 bytes; playback resolves it via
6	 * `URL.createObjectURL(blob)` at render time and `revokeObjectURL` on
7	 * unmount.
8	 *
9	 * `cueId` + `cueAtMs` are written by Phase 6.2's tag screen; clips with
10	 * neither field set are "needs tag" and excluded from Phase 6.3 playback.
11	 */
12	export interface ClipRecord {
13	  id: string
14	  name: string
15	  mimeType: string
16	  durationMs: number
17	  sizeBytes: number
18	  importedAt: number
19	  blob: Blob
20	  cueId?: CueId
21	  cueAtMs?: number
22	}
23	
24	export type AddClipResult =
25	  | { ok: true; clip: ClipRecord }
26	  | {
27	      ok: false
28	      reason: 'quota' | 'too-large' | 'unsupported-type' | 'storage-error'
29	      message: string
30	    }
31	
