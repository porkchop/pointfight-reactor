[tool_use] Write {"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/artifacts/phase-update.json","content":"{\n  \"phase\": \"phase-2\",\n  \"kind\": \"scope-split\",\n  \"summary\": \"Phase 2 bundled seven acceptance criteria; phone-as-sensor required substantial unrelated infrastructure (WebRTC signaling, companion page, accelerometer calibration). Split into Phase 2 (round structure + configurable input + motion indicator + delay extension + penalty counter + keyboard-fallback flag) and a new Phase 2b (phone-as-sensor, deferred to after Phase 3).\",\n  \"moved_from_phase_2_to_phase_2b\": [\n    \"Phone-as-sensor mode: companion page on phone sends commit event on accelerometer threshold, paired via QR code with local websocket or WebRTC DataChannel.\"\n  ],\n  \"retained_in_phase_2\": [\n    \"USB foot pedal works as configurable input (rebindable commit key)\",\n    \"Keyboard input remains as fallback, flagged in session metadata\",\n    \"Session structure supports rounds: configurable work / rest / round count (default 2:00 / 1:00 / 5)\",\n    \"Continuous-motion indicator between cues\",\n    \"Pre-cue delay upper bound configurable up to 8 s\",\n    \"Optional penalty counter: false starts + hesitations add reps to during-rest clear-list\"\n  ],\n  \"rationale\": \"The foot pedal already satisfies the spec's 'physical commitment, not keyboard tap from seated position' requirement. Phone-as-sensor is additive and uncertain (no server in project today). Splitting keeps Phase 2 shippable inside the athlete's 2-week competition window while preserving the original Phase 2b work for a follow-on phase.\",\n  \"approved_phase_numbering_unchanged\": true,\n  \"phase_1_status\": \"still approved (artifacts/phase-approval.json retained)\",\n  \"next_action\": \"Implement revised Phase 2 scope; write artifacts/phase-approval.json with phase=phase-2 when accepted.\"\n}\n"}
