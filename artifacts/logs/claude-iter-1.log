163	describe('deleteClip', () => {
164	  beforeEach(async () => {
165	    await clearClips()
166	  })
167	
168	  it('removes the row by id', async () => {
169	    const added = await addClip(makeFile({ name: 'doomed.mp4' }), {
170	      durationMs: 1000,
171	    })
172	    expect(added.ok).toBe(true)
173	    if (!added.ok) return
174	    await deleteClip(added.clip.id)
175	    const db = getDb()
176	    expect(await db?.clips.get(added.clip.id)).toBeUndefined()
177	  })
178	
179	  it('is a no-op when the id does not exist', async () => {
180	    await expect(deleteClip('does-not-exist')).resolves.toBeUndefined()
181	  })
182	})
