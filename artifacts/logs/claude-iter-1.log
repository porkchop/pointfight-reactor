[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/ui/PairScreen.tsx","old_string":"  // --- Setup: load settings, create peer, generate offer, attempt QR ---\n  useEffect(() => {\n    let cancelled = false\n    void (async () => {\n      const s = await loadSettings()\n      if (cancelled) return\n      const ip = s.laptopLanIp?.trim() ?? ''\n      setLanIp(ip || null)\n\n      const peer = createPeer()\n      peerRef.current = peer\n      peer.onStateChange((next) => {\n        if (cancelled) return\n        setPeerState(next)\n        if (next === 'connected') {\n          setQrState('connected')\n          // Reset the RTT baseline so \"Last commit received at +Xms\" is the\n          // pure phone→laptop send time the M5 manual gate budgets at <200ms,\n          // not the offer-creation + scan + handshake elapsed.\n          setStartedAt(Date.now())\n        }\n      })\n      peer.onMessage((m: PhoneMessage) => {\n        if (m.type === 'commit') {\n          setLastCommit({ receivedAt: Date.now(), sentAt: m.t })\n        }\n      })","new_string":"  // --- Setup: load settings, create peer, generate offer, attempt QR ---\n  useEffect(() => {\n    let cancelled = false\n    void (async () => {\n      const [s, profile] = await Promise.all([\n        loadSettings(),\n        loadActiveProfile(),\n      ])\n      if (cancelled) return\n      const ip = s.laptopLanIp?.trim() ?? ''\n      setLanIp(ip || null)\n      setActiveProfile(profile)\n\n      const peer = createPeer()\n      peerRef.current = peer\n      peer.onStateChange((next) => {\n        if (cancelled) return\n        setPeerState(next)\n        if (next === 'connected') {\n          setQrState('connected')\n          // Reset the RTT baseline so \"Last commit received at +Xms\" is the\n          // pure phone→laptop send time the M5 manual gate budgets at <200ms,\n          // not the offer-creation + scan + handshake elapsed.\n          setStartedAt(Date.now())\n          // Hand the phone the per-athlete threshold so the motion runner\n          // (Phase 2b.3) arms with the right value the moment the\n          // DataChannel opens. No threshold yet → use the default.\n          try {\n            peer.send({\n              type: 'config',\n              thresholdG:\n                profile.config.phoneCalibration?.thresholdG ??\n                DEFAULT_THRESHOLD_G,\n              debounceMs: DEFAULT_DEBOUNCE_MS,\n              mode: 'armed',\n            })\n          } catch {\n            /* peer not actually open yet — phone defaults to armed anyway */\n          }\n        }\n      })\n      peer.onMessage((m: PhoneMessage) => {\n        if (m.type === 'commit') {\n          setLastCommit({ receivedAt: Date.now(), sentAt: m.t })\n        }\n      })"}
