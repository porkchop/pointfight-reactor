[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/ui/CalibrateScreen.tsx","old_string":"  useEffect(() => {\n    if (status !== 'collecting') return\n    const off = peer.onMessage((m: PhoneMessage) => {\n      if (m.type !== 'sample') return\n      setPeaks((prev) => {\n        if (prev.length >= CALIBRATION_SAMPLE_COUNT) return prev\n        const next = [...prev, m.peakG]\n        // Trigger finish as a side-effect of the message callback (not an\n        // effect body) once the final sample lands. setPeaks itself stays\n        // pure: it returns the same `next` whether or not we kick off the\n        // save.\n        if (next.length === CALIBRATION_SAMPLE_COUNT) {\n          void finishCalibration(next)\n        }\n        return next\n      })\n    })\n    return off\n  }, [peer, status, finishCalibration])","new_string":"  useEffect(() => {\n    if (status !== 'collecting') return\n    const off = peer.onMessage((m: PhoneMessage) => {\n      if (m.type !== 'sample') return\n      if (peaksRef.current.length >= CALIBRATION_SAMPLE_COUNT) return\n      const next = [...peaksRef.current, m.peakG]\n      peaksRef.current = next\n      setPeaks(next)\n      if (next.length === CALIBRATION_SAMPLE_COUNT) {\n        void finishCalibration(next)\n      }\n    })\n    return off\n  }, [peer, status, finishCalibration])"}
