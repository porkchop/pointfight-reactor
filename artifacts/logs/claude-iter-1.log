328	  it('ties on weakness break by cueId ascending for determinism', () => {
329	    // Two go cues with identical weakness — picker returns the one with the
330	    // lexicographically smaller cueId first.
331	    const buildSession = (id: string, t: number) => {
332	      const sReps: RepRecord[] = []
333	      for (const cue of ['retreats', 'freezes'] as CueId[]) {
334	        for (let i = 0; i < 5; i++) {
335	          sReps.push(rep(id, cue, 'correct_go', 400, true))
336	        }
337	      }
338	      return session(id, t, sReps)
339	    }
340	    const a = buildSession('A', 1000)
341	    const b = buildSession('B', 2000)
342	    const map = new Map([
343	      [a.rec.id, a.reps],
344	      [b.rec.id, b.reps],
345	    ])
346	    const agg = cueAggregate([a.rec, b.rec], map)
347	    const rec = pickTaperCues(agg, 1)
348	    expect(rec.cueIds).toEqual(['freezes'])
349	  })
350	})
