[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/ui/SettingsScreen.tsx","old_string":"  async function handleBuildTaperProfile() {\n    const sessions = await listRecentSessions(5)\n    if (sessions.length === 0) {\n      setTaperError('No sessions yet — run a drill first.')\n      return\n    }\n    const reps = await listRepsForSessions(sessions.map((s) => s.id))\n    const agg = cueAggregate(sessions, reps)\n    const rec = pickTaperCues(agg, 3)\n    if (rec.cueIds.length === 0) {\n      setTaperError(rec.reason)\n      return\n    }\n    const today = new Date().toISOString().slice(0, 10)\n    const name = `Taper — ${today}`\n    const config: DrillConfig = {\n      ...DEFAULT_DRILL_CONFIG,\n      ...profile?.config,\n      rounds: 3,\n      workMs: 60_000,\n      restMs: 30_000,\n      maxReps: null,\n      allowedCueIds: rec.cueIds,\n    }\n    const fresh = { ...buildDefaultProfile(config), name }\n    await saveProfile(fresh)\n    await setActiveProfile(fresh.id)\n    setProfile(fresh)\n    setProfiles((prev) => [...prev, fresh])\n    setSettings((prev) => ({ ...prev, activeProfileId: fresh.id }))\n    setTaperReason(rec.reason)\n    setTaperError(null)\n  }","new_string":"  async function handleBuildTaperProfile() {\n    const sessions = await listRecentSessions(5)\n    if (sessions.length === 0) {\n      setTaperError('No sessions yet — run a drill first.')\n      setTaperReason(null)\n      return\n    }\n    const reps = await listRepsForSessions(sessions.map((s) => s.id))\n    const blueprint = buildTaperProfileBlueprint(\n      sessions,\n      reps,\n      profile?.config ?? DEFAULT_DRILL_CONFIG,\n      3,\n    )\n    if (!blueprint) {\n      setTaperError(\n        'Not enough data to pick taper cues. Drill more variety first.',\n      )\n      setTaperReason(null)\n      return\n    }\n    const today = new Date().toISOString().slice(0, 10)\n    const fresh = {\n      ...buildDefaultProfile(blueprint.config),\n      name: `Taper — ${today}`,\n    }\n    await saveProfile(fresh)\n    await setActiveProfile(fresh.id)\n    setProfile(fresh)\n    setProfiles((prev) => [...prev, fresh])\n    setSettings((prev) => ({ ...prev, activeProfileId: fresh.id }))\n    setTaperReason(blueprint.reason)\n    setTaperError(null)\n  }"}
