[tool_use] Edit {"replace_all":false,"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/app/src/ui/PairScreen.tsx","old_string":"  async function handleDecodedAnswer(payload: string): Promise<void> {\n    const dec = await tryDecodeOffer(payload)\n    if (!dec.ok) {\n      // Keep scanning; QR decoded but content is wrong shape (could be any\n      // QR in the camera's view). Resume the scan loop.\n      scheduleScan()\n      return\n    }\n    stopScanning()\n    setAnswerSdp(dec.sdp)\n    try {\n      await peerRef.current?.acceptAnswer(dec.sdp)\n    } catch (e) {\n      setErr(e instanceof Error ? e.message : String(e))\n      setQrState('error')\n    }\n  }","new_string":"  async function handleDecodedAnswer(payload: string): Promise<void> {\n    const dec = await tryDecodeOffer(payload)\n    if (!dec.ok) {\n      // Any QR in the camera's view lands here (stickers, screensavers,\n      // wifi-config QRs). Resume the scan loop so the operator doesn't\n      // have to reload to retry.\n      scheduleScan()\n      return\n    }\n    stopScanning()\n    setAnswerSdp(dec.sdp)\n    try {\n      await peerRef.current?.acceptAnswer(dec.sdp)\n    } catch (e) {\n      setErr(e instanceof Error ? e.message : String(e))\n      // Decoded payload was wire-valid but the SDP was junk. Re-enter the\n      // scan loop instead of dead-ending — the user can re-point at the\n      // phone or fall back to manual pairing from the toggle.\n      setQrState('showing-offer')\n      void handleStartScan()\n    }\n  }"}
