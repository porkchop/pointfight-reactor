[tool_result] toolu_01YMnSfWppKdMKtCqAH3HbWf 1	import { useSession } from './store/session'
2	import { IdleScreen } from './ui/IdleScreen'
3	import { TrainerScreen } from './ui/TrainerScreen'
4	import { SummaryScreen } from './ui/SummaryScreen'
5	import './App.css'
6	
7	function App() {
8	  const phase = useSession((s) => s.phase)
9	
10	  if (phase === 'idle') return <IdleScreen />
11	  if (phase === 'ended') return <SummaryScreen />
12	  return <TrainerScreen />
13	}
14	
15	export default App
16	
