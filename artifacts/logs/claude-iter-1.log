[tool_use] Write {"file_path":"/home/aaron/dev/projects/aaron/pointfight-reactor/artifacts/phase-update.json","content":"{\n  \"phase\": \"phase-2b\",\n  \"approved\": false,\n  \"kind\": \"phase-update\",\n  \"summary\": \"Phase 2b (Phone-as-Sensor) is the next unapproved phase after Phase 5. Planning gate triggered: cross-layer change (transport + UI + storage + engine wiring), persistence/schema touches (ProfileRecord.config gains phoneCalibration in 2b.3), at least three plausible signaling strategies, and security/threat-model considerations (LAN trust). Strategy-planner produced a four-sub-phase decomposition (2b.1 LAN companion + manual SDP transport, 2b.2 QR pairing UX, 2b.3 motion + calibration, 2b.4 engine wiring). Architecture-red-team reviewed and flagged four blocking concerns (B1 hand-waved nonce defense, B2 acceptance criteria mandate behavior the test strategy declared untestable, B3 unfalsifiable 2b.3 acceptance, B4 iOS-vs-Android ambiguity in the SPEC's single-athlete model) plus eight non-blocking observations. All four blockers are resolved in the memo before any 2b.1 code is written: B1 dropped in favor of an explicit LAN-trust model, B2 records a project-scoped testing-gate concession with the verify-phaseN.mjs precedent and requires a manual_qa field on each sub-phase approval, B3 rewrites the motion-detection criteria into laptop-observable falsifiable counts, B4 commits to Android-gated acceptance with iOS shipped as a documented mkcert path. Non-blockers N1/N3/N5/N6/N7/N8 are also resolved in the memo (throwaway-scaffold note, default STUN server, Zustand peer slice, per-profile calibration storage, lazy-loaded QR libs, explicit wake-lock fallback). docs/PHASES.md is updated to record 2b.1–2b.4 with concrete acceptance criteria and bundle budgets. The original Phase 2b shell + criteria remain in PHASES.md for traceability. No code changes this iteration — implementation of 2b.1 happens next iteration with a clean spec. Verification sprint still green: 105/105 vitest, lint + tsc + vite build all clean.\",\n  \"decision_memo\": \"artifacts/decision-memo.md\",\n  \"subphases_added\": [\n    {\n      \"id\": \"phase-2b.1\",\n      \"title\": \"LAN companion + WebRTC DataChannel transport\",\n      \"summary\": \"Phone loads /phone from the laptop on the same Wi-Fi; manual offer/answer paste establishes a DataChannel; commit messages are echoed to the laptop's debug surface. Throwaway UX intentionally — 2b.2 replaces the paste with QR.\",\n      \"files_to_add\": [\n        \"app/src/phone/peer.ts\",\n        \"app/src/phone/wire.ts\",\n        \"app/src/phone/PhoneApp.tsx\",\n        \"app/src/ui/PairScreen.tsx\",\n        \"app/src/phone/peer.test.ts\",\n        \"app/src/phone/wire.test.ts\",\n        \"app/verify-phase-2b1.mjs\"\n      ],\n      \"files_to_modify\": [\n        \"app/src/main.tsx\",\n        \"app/src/store/settings-types.ts\",\n        \"app/src/store/settings.ts\",\n        \"app/src/ui/SettingsScreen.tsx\",\n        \"app/vite.config.ts\",\n        \"docs/QUALITY_GATES.md\"\n      ],\n      \"bundle_budget_gzip_kb\": 20,\n      \"manual_qa_required\": true\n    },\n    {\n      \"id\": \"phase-2b.2\",\n      \"title\": \"QR-code pairing flow\",\n      \"summary\": \"Replace manual paste with QR codes. Laptop renders offer QR; phone scans and auto-applies; phone renders answer QR; laptop webcam reads it via jsqr.\",\n      \"depends_on\": [\"phase-2b.1\"],\n      \"files_to_add\": [\n        \"app/src/phone/qr.ts\",\n        \"app/src/phone/qr.test.ts\",\n        \"app/src/util/camera.ts\",\n        \"app/verify-phase-2b2.mjs\"\n      ],\n      \"dependencies_to_add\": [\"jsqr\", \"qrcode\"],\n      \"bundle_budget_gzip_kb_main\": 0,\n      \"lazy_load_pair_screen\": true,\n      \"manual_qa_required\": true\n    },\n    {\n      \"id\": \"phase-2b.3\",\n      \"title\": \"Accelerometer threshold + calibration\",\n      \"summary\": \"Phone reads devicemotion; debounced peak-impulse metric drives a commit event. Laptop calibration screen captures 5 swings and persists threshold to ProfileRecord.config.phoneCalibration.\",\n      \"depends_on\": [\"phase-2b.2\"],\n      \"files_to_add\": [\n        \"app/src/phone/motion.ts\",\n        \"app/src/phone/motion.test.ts\",\n        \"app/src/ui/CalibrateScreen.tsx\",\n        \"docs/SETUP_IOS.md\",\n        \"app/verify-phase-2b3.mjs\"\n      ],\n      \"schema_change\": \"ProfileRecord.config.phoneCalibration?: { thresholdG: number; calibratedAt: number } — additive, no Dexie version bump\",\n      \"manual_qa_required\": true,\n      \"ios_acceptance\": \"documented, not CI-gated\"\n    },\n    {\n      \"id\": \"phase-2b.4\",\n      \"title\": \"Wire inputSource = 'phone' into engine + sessions\",\n      \"summary\": \"Add 'phone' to InputSource union; Settings exposes the option; Idle gates Start on a paired phone; TrainerScreen subscribes to the DataChannel and routes commit messages to recordPress.\",\n      \"depends_on\": [\"phase-2b.3\"],\n      \"files_to_modify\": [\n        \"app/src/engine/types.ts\",\n        \"app/src/ui/SettingsScreen.tsx\",\n        \"app/src/ui/IdleScreen.tsx\",\n        \"app/src/ui/TrainerScreen.tsx\"\n      ],\n      \"manual_qa_required\": true\n    }\n  ],\n  \"blockers_resolved\": [\n    {\n      \"id\": \"B1\",\n      \"title\": \"Hand-waved offer-SDP nonce defense\",\n      \"resolution\": \"Dropped. LAN trust model — pairing is implicitly authorized by the human holding the phone. If a real threat model emerges, a signed-envelope follow-up can ship.\"\n    },\n    {\n      \"id\": \"B2\",\n      \"title\": \"WebRTC + getUserMedia + DeviceMotion are not testable under vitest/Playwright\",\n      \"resolution\": \"Project-scoped testing-gate concession recorded in the memo and slated for a one-line footnote in docs/QUALITY_GATES.md during 2b.1. Pure-logic modules (peer state machine, wire format, motion impulse) are vitest-gated; transport/handshake/sensor is gated by app/verify-phase-2bN.mjs manual scripts. Each sub-phase approval artifact must include a manual_qa field naming the device and steps.\"\n    },\n    {\n      \"id\": \"B3\",\n      \"title\": \"Unfalsifiable 2b.3 acceptance ('within 50ms of impulse peak')\",\n      \"resolution\": \"Rewritten to laptop-observable counts: 60s at rest → 0 commits; 5 deliberate impulses → 5 commits; double-snap within 300ms → 1 commit; calibration persists across reload.\"\n    },\n    {\n      \"id\": \"B4\",\n      \"title\": \"iOS-or-Android ambiguity blocks acceptance gating\",\n      \"resolution\": \"Android-gated acceptance for 2b.1–2b.3 (works on plain HTTP via Chrome). iOS shipped as a documented mkcert path in docs/SETUP_IOS.md (authored in 2b.3). If the athlete is on iOS, they follow the doc once; if blocked, they fall back to pedal + keyboard. SPEC.md is silent on phone OS, so the strategy is both-supported with explicit gating asymmetry.\"\n    }\n  ],\n  \"non_blockers_resolved_in_memo\": [\n    \"N1 — PairScreen 2b.1 textareas explicitly tagged as throwaway scaffolding\",\n    \"N3 — STUN server defaults to stun:stun.l.google.com:19302; documented as a one-shot UDP packet, not ongoing traffic\",\n    \"N5 — Phone peer lives in a Zustand slice (consistent with useSession/useSettings/useProfiles), not a module-level singleton\",\n    \"N6 — Per-profile calibration storage on ProfileRecord.config; SettingsRecord stays small\",\n    \"N7 — Bundle budgets explicit (+20 KB gzip for 2b.1; main bundle +0 KB for 2b.2 via React.lazy)\",\n    \"N8 — Wake-lock fallback specified (banner on browsers without navigator.wakeLock instead of silent degradation)\"\n  ],\n  \"verification_sprint\": {\n    \"tests\": \"105/105 vitest tests pass (Phase 5 baseline preserved).\",\n    \"lint\": \"eslint clean.\",\n    \"typecheck\": \"tsc -b clean.\",\n    \"build\": \"vite build clean (341 KB JS / 105 KB gzip, no growth).\",\n    \"phase4_5_regression\": \"no code changes this iteration; analytics + drill profiles remain functional per prior qa-playwright signoffs in artifacts/phase{4,5}-verify/.\"\n  },\n  \"gates\": {\n    \"planning\": \"decision-memo.md is the planning artifact for the entire Phase 2b decomposition; covers signaling/hosting/iOS tradeoffs with comparison + recommendation per option.\",\n    \"adversarial_review\": \"architecture-red-team reviewed; four blockers + eight non-blockers all addressed in the memo. Memo updated in-place before phase-update.json was written.\",\n    \"drift\": \"No prior-phase invariants touched. RepRecord/SessionRecord/Dexie schema unchanged. Phase 4 ProfileRecord.config will gain an optional phoneCalibration field in 2b.3 (additive, no version bump).\",\n    \"docs_updated\": \"docs/PHASES.md records 2b.1–2b.4 with concrete criteria. artifacts/decision-memo.md is the canonical planning record.\"\n  },\n  \"next_action\": \"Implement phase-2b.1 in the next iteration. The memo and PHASES.md are the spec; the verify script at app/verify-phase-2b1.mjs is the manual-QA gate.\",\n  \"suggested_commit_message\": \"phase-2b: decomposition plan + sub-phase split (2b.1 through 2b.4)\"\n}\n"}
