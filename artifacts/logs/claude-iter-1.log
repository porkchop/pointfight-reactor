14	function App() {
15	  const phase = useSession((s) => s.phase)
16	  const [showSettings, setShowSettings] = useState(false)
17	  const [settings, setSettings] = useState<SettingsRecord>(DEFAULT_SETTINGS)
18	
19	  useEffect(() => {
20	    void loadSettings().then(setSettings)
21	  }, [showSettings])
22	
23	  if (showSettings) {
24	    return <SettingsScreen onClose={() => setShowSettings(false)} />
25	  }
26	  if (phase === 'idle')
27	    return <IdleScreen onOpenSettings={() => setShowSettings(true)} />
28	  if (phase === 'ended') return <SummaryScreen />
